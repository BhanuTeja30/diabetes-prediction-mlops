# Copy to .env and adjust. Never commit .env.

# --- API ---
LOG_LEVEL=INFO
MODEL_DIR=models/production
MODEL_CONFIG_PATH=configs/model_config.yaml
MAX_REQUEST_BYTES=4096
# Operational prediction metadata (hour bucket, class, probability, latency; no identifiers)
MONITORING_LOG_PREDICTIONS=true
# Raw feature values are health data: enable ONLY with documented approval/consent
MONITORING_LOG_FEATURES=false
# Enables POST /admin/reload when set to a long random value
ADMIN_TOKEN=

# --- Authentication (users and admins) ---
# HMAC key for sign-in tokens, >= 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_DB_PATH=data/auth/users.db
TOKEN_TTL_MINUTES=60
# Let people create their own (user-role) accounts on the sign-in page
ALLOW_SELF_REGISTRATION=true
# First admin account, created at API start-up only if no admin exists yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Frontend ---
API_URL=http://localhost:8000

# --- MLflow ---
MLFLOW_ENABLED=true
# Local default (no server needed): sqlite:///mlflow.db
# With Docker Compose running: http://localhost:5000
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=diabetes-risk-prediction
MLFLOW_REGISTERED_MODEL_NAME=diabetes-risk-classifier

# --- Docker Compose ports / Grafana ---
API_PORT=8000
FRONTEND_PORT=8501
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Public server only (docker-compose.prod.yml) ---
# Host name for HTTPS; deploy/server-setup.sh sets this
SITE_ADDRESS=
