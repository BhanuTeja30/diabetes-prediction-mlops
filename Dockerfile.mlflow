# MLflow tracking server + model registry (SQLite backend, proxied artifact store on a volume).
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install mlflow==3.15.0

RUN useradd --create-home --uid 1000 mlflow && mkdir -p /mlflow && chown mlflow:mlflow /mlflow
USER mlflow
WORKDIR /mlflow

EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:5000/health', timeout=4).status == 200 else 1)"

CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", \
     "--serve-artifacts", \
     "--host", "0.0.0.0", "--port", "5000", \
     "--allowed-hosts", "localhost:5000,127.0.0.1:5000,mlflow:5000,localhost,mlflow"]
